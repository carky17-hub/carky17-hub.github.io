# GitHub Actions 빌드 환경변수 입력용 예시. 실제 값을 저장소에 커밋하지 마세요.
SITE_URL=https://eodigagae.com
BUSINESS_NAME=강마케팅
BUSINESS_REPRESENTATIVE=
BUSINESS_NUMBER=
BUSINESS_ADDRESS=
BUSINESS_PHONE=
BUSINESS_JURISDICTION=
CONTACT_EMAIL=
POLICY_EFFECTIVE_DATE=
POLICY_VERSION=draft-2026-11-25
PUBLIC_DATA_APPROVED=false
POLICY_APPROVED=false
ADS_POLICY_APPROVED=false
ALLOW_INDEXING=false
ENABLE_FORMS=false
ENABLE_ADFIT=false
ADFIT_MID=
ADFIT_BOTTOM=
NAVER_SITE_VERIFICATION=
GOOGLE_SITE_VERIFICATION=
SHEET_CORRECTIONS_CSV_URL=
SHEET_ADS_CSV_URL=
SHEET_PREMIUM_CSV_URL=

FORM_ENDPOINT=
FORM_PROVIDER=
FORM_PROVIDER_COUNTRY=
FORM_PROVIDER_CONTACT=
FORM_PROVIDER_RETENTION=
FORM_INTERNATIONAL_TRANSFER=false
KAKAO_CHANNEL_URL=

FORM_FILE_UPLOADS=false

# Android public Digital Asset Links (no private key)
ANDROID_PACKAGE_ID=com.eodigagae.app
ANDROID_SHA256_CERT_FINGERPRINTS=

# v1.7.2: all provider functions are opt-in; check provider's written permission first.
NAVER_WORKER_URL=
NAVER_SEARCH_APPROVED=false
NAVER_IMAGE_APPROVED=false
NAVER_MATCH_APPROVED=false
GOOGLE_MODE=all
GOOGLE_WORKER_URL=
IMAGE_ON_CARDS=false

# Worker에 GOOGLE_SERVER_KEY secret 등록 (GitHub/브라우저 금지).

# v1.9 optional anonymous action counts
ENABLE_ANALYTICS=false
ANALYTICS_WORKER_URL=

# Public Kakao JavaScript key, domain restricted
KAKAO_JS_KEY=
